# Makefile for STM32F407ZGTx AD9226采集端 (VS Code + arm-none-eabi-gcc + OpenOCD/DAPmini)
##########################################################################################################################

# 工具链
PREFIX  = arm-none-eabi-
CC      = $(PREFIX)gcc
AS      = $(PREFIX)gcc -x assembler-with-cpp
CP      = $(PREFIX)objcopy
SZ      = $(PREFIX)size

# 工程名 + 输出目录
TARGET  = AD9226_driver
BUILD_DIR = build

# 默认目标:all(含 .elf + .hex + .bin)
.DEFAULT_GOAL := all

# CPU / FPU
CPU     = -mcpu=cortex-m4
FPU     = -mfpu=fpv4-sp-d16
FLOAT-ABI = -mfloat-abi=hard
MCU     = $(CPU) -mthumb $(FPU) $(FLOAT-ABI)

# 编译选项
CFLAGS  = $(MCU) -std=gnu11 -DSTM32F407xx -DUSE_HAL_DRIVER -DUSE_FULL_LL_DRIVER
CFLAGS += -O2 -g3 -Wall -ffunction-sections -fdata-sections
CFLAGS += -Wno-unused-parameter -Wno-unused-variable
CFLAGS += -Wno-implicit-function-declaration

# 头文件
CFLAGS  += -I Core/Inc
CFLAGS  += -I Drivers/STM32F4xx_HAL_Driver/Inc
CFLAGS  += -I Drivers/STM32F4xx_HAL_Driver/Inc/Legacy
CFLAGS  += -I Drivers/CMSIS/Device/ST/STM32F4xx/Include
CFLAGS  += -I Drivers/CMSIS/Include
CFLAGS  += -I USER/app
CFLAGS  += -I USER/bsp
CFLAGS  += -I USER/config
CFLAGS  += -I USER/drivers
CFLAGS  += -I USER/protocol
CFLAGS  += -I USER/signal

# 链接
LDSCRIPT = STM32F407xx_FLASH.ld
LIBS     = -lc -lm -lnosys
# -u _printf_float 强制链入 newlib-nano 的 float printf 支持,否则 %.2f 不会输出
LDFLAGS  = $(MCU) -specs=nano.specs -u _printf_float -u _scanf_float -T$(LDSCRIPT) $(LIBS) -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections

# 源文件
C_SOURCES = \
Core/Src/main.c \
Core/Src/ad9226.c \
Core/Src/spi.c \
Core/Src/spicmd.c \
Core/Src/equivalent_sampling.c \
USER/protocol/h743_measurement_rx.c \
USER/protocol/h743_measurement_model.c \
USER/signal/ad9226_code_normalizer.c \
Core/Src/stm32f4xx_it.c \
Core/Src/system_stm32f4xx.c \
Core/Src/stm32f4xx_hal_msp.c \
  USER/app/screen_app.c \
  USER/app/measurement_lock_policy.c \
  USER/app/screen_signal_model.c \
USER/app/screen_view.c \
USER/app/screen_test.c \
USER/bsp/screen_key.c \
USER/bsp/screen_spi.c \
USER/bsp/screen_i2c.c \
USER/drivers/hmi_tjc.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_cortex.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_dma.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_dma_ex.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_gpio.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_rcc.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_rcc_ex.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_spi.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_tim.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_tim_ex.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash_ex.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_flash_ramfunc.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_pwr.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_pwr_ex.c \
Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_exti.c \
Core/Src/sysmem.c \
Core/Src/syscalls.c

ASM_SOURCES = \
Drivers/CMSIS/Device/ST/STM32F4xx/Source/Templates/gcc/startup_stm32f407xx.s

# 目标
OBJECTS  = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR)
	@echo "  CC    $<"
	@$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	@echo "  AS    $<"
	@$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile
	@echo "  LD    $@"
	@$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	@echo "  SZ    $@"
	@$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	@echo "  CP    $@"
	@$(CP) -O ihex $< $@

$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	@echo "  CP    $@"
	@$(CP) -O binary -S $< $@

$(BUILD_DIR):
	@mkdir -p $@

.PHONY: all clean flash flash-cmsis-dap debug stflash
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin

clean:
	@rm -rf $(BUILD_DIR)

# 烧录 (ST-Link V2/V3 + OpenOCD),可通过 STLINK_SERIAL_F4 选择探针
# 兼容 V2/V2-1/V3:OpenOCD 用 interface/stlink.cfg,加 transport select hla_swd 强制 SWD
# 备选:stlink-tools(更简单,见 make stflash 目标)
STLINK_SERIAL_F4 ?=
STLINK_SELECT_F4 := $(if $(strip $(STLINK_SERIAL_F4)),-c "adapter serial $(STLINK_SERIAL_F4)",)
flash: all
	openocd -f interface/stlink.cfg $(STLINK_SELECT_F4) \
		-c "transport select hla_swd" \
		-f target/stm32f4x.cfg \
		-c "program $(BUILD_DIR)/$(TARGET).elf verify reset exit"

flash-cmsis-dap: all
	openocd -f interface/cmsis-dap.cfg \
		-f target/stm32f4x.cfg \
		-c "program $(BUILD_DIR)/$(TARGET).elf verify reset exit"

debug: all
	openocd -f interface/stlink.cfg $(STLINK_SELECT_F4) \
		-c "transport select hla_swd" \
		-f target/stm32f4x.cfg

# 备选:用 stlink-tools 烧录(对克隆版 V2 更友好)
# 用法:make stflash
stflash: all
	st-flash --connect-under-reset write $(BUILD_DIR)/$(TARGET).bin 0x08000000
